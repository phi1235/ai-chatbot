APP_NAME="AI Chatbot Agent"
APP_ENV=local

# ─── Backend (uvicorn auto-đọc UVICORN_*) ──────────────────────────────────
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# ─── UI (streamlit auto-đọc STREAMLIT_*) ───────────────────────────────────
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# ─── UI → Backend URL ──────────────────────────────────────────────────────
# Dev local: http://localhost:8000
# Docker compose: http://backend:8000 (service name trong cùng network)
DEFAULT_API_URL=http://localhost:8000

# ─── Logging ────────────────────────────────────────────────────────────────
# json (production) | text (dev) | (rỗng = auto theo TTY)
LOG_FORMAT=
LOG_LEVEL=INFO

# ─── OpenRouter LLM ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free model trên OpenRouter (danh sách thay đổi theo thời gian, check tại
# https://openrouter.ai/models?max_price=0). Một vài lựa chọn tốt cho RAG tiếng Việt:
#   google/gemma-3-27b-it:free          ← cân bằng tốt, multilingual
#   qwen/qwen3-next-80b-a3b-instruct:free   ← chất lượng cao cho VN, chậm hơn
#   meta-llama/llama-3.2-3b-instruct:free   ← rất nhanh, chất lượng vừa
#   openai/gpt-oss-120b:free            ← OpenAI open-source, mạnh
#   nvidia/nemotron-nano-9b-v2:free     ← nhanh, gọn
OPENROUTER_MODEL=google/gemma-3-27b-it:free
ENABLE_LLM_REASONING=false
MAX_RESPONSE_TOKENS=400
LLM_REQUEST_TIMEOUT=30

# ─── API Gateway ────────────────────────────────────────────────────────────
API_KEYS=
RATE_LIMIT_PER_MINUTE=30
MAX_MESSAGE_LENGTH=2000
RETRIEVAL_TOP_K=3
MAX_CONTEXT_CHARS=600

# ─── ChromaDB / Embedding ───────────────────────────────────────────────────
CHROMA_PATH=./db/chroma_store
CHROMA_COLLECTION=ai_knowledge
# Multilingual embedding hỗ trợ tiếng Việt
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_SIZE=256

# ─── Hybrid Search (BM25 keyword + Vector semantic) ─────────────────────────
HYBRID_SEARCH_ENABLED=true
BM25_INDEX_PATH=./db/bm25_index.pkl
# Reciprocal Rank Fusion - 60 là chuẩn
RRF_K=60
# Số chunks lấy từ mỗi nguồn trước khi merge
HYBRID_FETCH_K=10

# ─── Cross-encoder Re-ranker (optional) ─────────────────────────────────────
# Tăng precision của top-K cuối nhưng cộng latency:
#   GPU: +200-500ms
#   CPU: +3-12s với 10 chunks (chậm) - chỉ bật nếu chấp nhận chờ
# Default OFF; bật khi có GPU hoặc cần chất lượng tối đa.
RERANKER_ENABLED=false
# Model multilingual, ~280MB. Alternatives:
#   BAAI/bge-reranker-v2-m3   (mạnh nhất, ~568MB)
#   cross-encoder/ms-marco-MiniLM-L-6-v2  (~100MB, English only)
RERANKER_MODEL=BAAI/bge-reranker-base
# Số chunks đưa vào reranker. Càng cao càng chính xác nhưng càng chậm.
# CPU: 10 hợp lý. GPU: có thể tăng lên 20-30.
RERANKER_FETCH_K=10

# ─── Cache & Safety ─────────────────────────────────────────────────────────
ANSWER_CACHE_TTL=3600
ANSWER_CACHE_SIZE=256
PII_REDACTION_ENABLED=true

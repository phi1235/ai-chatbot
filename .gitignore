# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# Environment variables (.env.example được track để dev mới biết cần config gì)
.env
.env.bak

# ChromaDB & SQLite & runtime data (vector store + conversation history với dữ liệu cá nhân)
# Toàn bộ db/ là data sinh ra khi chạy, không track
db/*
!db/.gitkeep

# Crawled data (HTML/text raw từ docs bên thứ 3 - copyright của họ + dung lượng lớn)
# Người clone repo sẽ tự `python ingest.py` để tạo lại data của riêng mình
data/raw/
data/clean/

# tool state
.codex
.devin/

# local handoff / scratch prompts
.devin-*.txt

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Streamlit
.streamlit/

# Local task handoff / ticket notes (do not commit planning docs)
docs/tickets/*.md
